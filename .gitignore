# 敏感憑證與私密金鑰 (絕對禁止推送到 GitHub)
.env
.env.*
*.key
*.pem
secrets.toml

# Python 編譯快取與暫存目錄
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 系統隱藏檔與雲端硬碟同步衝突檔/備份目錄
.DS_Store
Thumbs.db
desktop.ini
* (*).py
* (*).json
* (*).md
* (*)/
archive_*/
temp_*
*.tmp
~$*

# 資料輸出與大型模型衍生目錄
evaluation_reports/
student_submissions/
checkpoints/
model_weights/
*.log
_cache/
logs/

# 大檔排除 (超過 GitHub 100MB 限制之全量合成庫與權重)
*1m_judicial_reasoning*.jsonl
*master_sft_unified*.jsonl
*balanced_weighted*.jsonl
*.safetensors
*.bin
*.pt

# 資料庫與大庫檔案
*.db
*.db-wal
*.db-shm
*.sqlite3
data/*.db
data/*.sqlite3

# 忽略 data 內的動態暫存目錄與本地個人筆記原檔（單一真理來源已收斂至主 data/）
data/evaluation_reports/
data/student_submissions/
data/checkpoints/
data/model_weights/
data/SamsungNotes/
